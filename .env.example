# ─── Site ───────────────────────────────────────────────────────────────
# Public URL used for canonical links, Open Graph, sitemap and Stripe return URLs.
NEXT_PUBLIC_SITE_URL=https://pubmaxagency.com

# ─── Audit form → e-mail notification via Resend (server only) ──────────
# API key from https://resend.com/api-keys
RESEND_API_KEY=
# Inbox that receives each audit request (comma-separated for several).
LEAD_NOTIFY_EMAIL=
# Sender. Leave empty to use "PubMax <onboarding@resend.dev>" (only delivers to your Resend account e-mail).
# Once pubmaxagency.com is verified in Resend: PubMax <formulaire@pubmaxagency.com>
LEAD_FROM_EMAIL=

# ─── Agency lead form → CRM (server only) ───────────────────────────────
# e.g. GoHighLevel: Automation → Workflow → trigger "Inbound Webhook" → copy its URL.
LEAD_WEBHOOK_URL=
# Optional shared secret sent as the X-Webhook-Secret header.
LEAD_WEBHOOK_SECRET=

# ─── Consultation scheduling — Calendly (server only) ───────────────────
# Personal access token (Calendly → Integrations → API & Webhooks). Scheduling API requires a paid Calendly plan.
CALENDLY_API_TOKEN=
# URI of the 60-minute event type, e.g. https://api.calendly.com/event_types/XXXXXXXX
CALENDLY_EVENT_TYPE_URI=

# ─── Consultation payment — Stripe Checkout in MAD (server only) ────────
# Use sk_test_… while testing. Never expose this key to the browser.
STRIPE_SECRET_KEY=
# Signing secret of the endpoint https://<your-domain>/api/booking/webhook (whsec_…)
STRIPE_WEBHOOK_SECRET=

# Optional: notified on every confirmed / problematic booking (GoHighLevel, Slack, Make…).
BOOKING_NOTIFY_WEBHOOK_URL=

# ─── Analytics (public IDs, loaded only after consent) ──────────────────
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# ─── VSL video (hero) ───────────────────────────────────────────────────
# YouTube, Vimeo or direct .mp4 URL. Empty → "bientôt disponible" placeholder.
NEXT_PUBLIC_VSL_URL=

# ─── Ebook guide ────────────────────────────────────────────────────────
# Where ebook requests are sent (falls back to LEAD_WEBHOOK_URL).
EBOOK_WEBHOOK_URL=
# Public URL of the PDF. Or drop the file at public/guides/guide-acquisition-ecommerce.pdf.
# With neither, visitors get the online guide on pubmaxagency.com.
EBOOK_FILE_URL=
